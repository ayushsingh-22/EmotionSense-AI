# Temporary frontend database connection; retained until Phase 3b.

# NextAuth encrypted cookie secret and exact canonical origin.
NEXTAUTH_SECRET=<generated-nextauth-secret>
NEXTAUTH_URL=http://localhost:3000

# Backend origin; point this to the local backend for local testing.
NEXT_PUBLIC_API_URL=http://localhost:8788

# Local development test only: enable forced refresh checks.
# AUTH_TEST_FORCE_REFRESH=true
