# Database (Neon Postgres via Prisma) — same value as backend/.env DATABASE_URL
DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Must be the SAME value as backend/.env NEXTAUTH_SECRET — used to sign the
# short-lived bearer token sent to the Express backend on the user's behalf.

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8080
