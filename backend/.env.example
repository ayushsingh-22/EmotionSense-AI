# Database (Neon Postgres via Prisma)
# Get this from your Neon project dashboard: https://console.neon.tech
# Use the "pooled" connection string for normal app traffic.
DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"

# Auth
# REQUIRED. Dedicated signing secret (>= 32 chars) shared ONLY between the
# Vercel frontend (which mints short-lived bearer tokens after a NextAuth
# sign-in) and this API (which verifies them). Identical on both sides, and
# must NOT equal NEXTAUTH_SECRET. No fallback: the server refuses to start
# without it. Generate with: openssl rand -base64 48
API_JWT_SECRET=

# Cron
# Required for GET /api/cron/ping (keeps Neon warm). Generate any random string.
CRON_SECRET=

# --- Everything below is unrelated to the Neon/Supabase migration ---
# Gemini API Configuration (Primary LLM)
# Either the modern single GEMINI_API_KEY, or the legacy GEMINI_API_KEY1/2
# two-key rotation pair (or both — every configured key is tried in order).
GEMINI_API_KEY=
GEMINI_API_KEY1=
GEMINI_API_KEY2=
# Leave GEMINI_MODEL unset — src/utils/modelCatalog.js auto-picks the best
# currently-available model daily. Only set this to force a specific model
# (e.g. while debugging a provider-side regression); it's not needed otherwise.
GEMINI_MODEL=

# Groq (LLaMA fallback + Speech-to-Text)
GROQ_API_KEY=
# Same as above — leave LLAMA_MODEL/GROQ_MODEL unset in normal use. Groq
# renames/retires models often, so modelCatalog.js re-picks the best one daily
# instead of relying on a name hardcoded here.
LLAMA_MODEL=
GROQ_MODEL=

# Text-to-Speech
GOOGLE_TTS_API_KEY=
SARVAM_API_KEY=
MURF_API_KEY=
OPENAI_API_KEY=

# HuggingFace
HUGGINGFACE_API_KEY=

# Email (Nodemailer) — used for emergency contact alerts
EMAIL_ENABLED=false
EMAIL_PROVIDER=
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# Server
PORT=8080
NODE_ENV=development
# Comma-separated browser origin allow-list. "*" is NOT honoured. In production
# an empty value blocks all cross-origin browser access. A "*" inside an entry
# matches a single DNS label, e.g. https://mantra-*-yourteam.vercel.app
CORS_ORIGIN=http://localhost:3000
# Render sits behind exactly one proxy hop (needed for correct client IPs).
TRUST_PROXY_HOPS=1
# Optional rate-limit overrides (defaults shown)
# RATE_LIMIT_GLOBAL_PER_15MIN=1000
# RATE_LIMIT_AUTH_FAILURES_PER_15MIN=60
# RATE_LIMIT_AI_PER_MIN=20
# RATE_LIMIT_AI_PER_DAY=500
# RATE_LIMIT_SENSITIVE_PER_HOUR=20

# ---------------------------------------------------------------------------
# Firebase identity exchange (Phase 2B.3) - MindHaven Android sign-in
# Off unless exactly "true". When true and Firebase Admin is misconfigured the
# server refuses to boot. Requires the identity migration (else answers 503).
FIREBASE_EXCHANGE_ENABLED=false
# The pinned Firebase project; tokens of any other project are refused.
# Use separate Firebase projects for development and production.
FIREBASE_PROJECT_ID=
# Firebase Admin credentials - ONE of the two forms (never commit real values):
#  (a) base64 of the service-account JSON (preferred)
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
#  (b) client e-mail + PEM private key ("
" escapes accepted)
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# Optional exchange rate limits (defaults shown)
# RATE_LIMIT_EXCHANGE_PER_15MIN=60
# RATE_LIMIT_EXCHANGE_FAILURES_PER_15MIN=20
# RATE_LIMIT_EXCHANGE_PER_UID_PER_15MIN=30

# ---------------------------------------------------------------------------
# Account linking (Phase 2B.5B.2) - link a Firebase sign-in to an existing web account
# Off unless exactly "true" AND FIREBASE_EXCHANGE_ENABLED is "true". Requires the
# auth_link_challenges migration (else answers 503).
ACCOUNT_LINKING_ENABLED=false
# Max age (seconds) of the Firebase sign-in (auth_time) at both linking steps.
# Clamped to 60..3600. Default 600.
# ACCOUNT_LINK_MAX_AUTH_AGE_SECONDS=600
# Optional linking rate limits (defaults shown)
# RATE_LIMIT_LINK_PER_15MIN=30
# RATE_LIMIT_LINK_FAILURES_PER_15MIN=15
# RATE_LIMIT_LINK_PER_UID_PER_15MIN=15
# RATE_LIMIT_LINK_PASSWORD_FAILURES_PER_15MIN=5

# ---------------------------------------------------------------------------
# Local development / tests only (never set on Render)
# Database-writing integration tests refuse to run unless this names the
# DEVELOPMENT Neon branch.
# EXPECTED_NEON_BRANCH_ID=
# Nightly journal generation is off in local development unless "true".
# JOURNAL_SCHEDULER_ENABLED=
