# Database (Neon Postgres via Prisma)
# Get this from your Neon project dashboard: https://console.neon.tech
# Use the "pooled" connection string for normal app traffic.
DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"

# Auth
# REQUIRED. Dedicated signing secret (>= 32 chars) shared ONLY between the
# Vercel frontend (which mints short-lived bearer tokens after a NextAuth
# sign-in) and this API (which verifies them). Identical on both sides, and
# must NOT equal NEXTAUTH_SECRET. No fallback: the server refuses to start
# without it. Generate with: openssl rand -base64 48
API_JWT_SECRET=

# Cron
# Required for GET /api/cron/ping (keeps Neon warm). Generate any random string.
CRON_SECRET=

# --- Everything below is unrelated to the Neon/Supabase migration ---
# Gemini API Configuration (Primary LLM)
# Either the modern single GEMINI_API_KEY, or the legacy GEMINI_API_KEY1/2
# two-key rotation pair (or both — every configured key is tried in order).
GEMINI_API_KEY=
GEMINI_API_KEY1=
GEMINI_API_KEY2=
# Leave GEMINI_MODEL unset — src/utils/modelCatalog.js auto-picks the best
# currently-available model daily. Only set this to force a specific model
# (e.g. while debugging a provider-side regression); it's not needed otherwise.
GEMINI_MODEL=

# Groq (LLaMA fallback + Speech-to-Text)
GROQ_API_KEY=
# Same as above — leave LLAMA_MODEL/GROQ_MODEL unset in normal use. Groq
# renames/retires models often, so modelCatalog.js re-picks the best one daily
# instead of relying on a name hardcoded here.
LLAMA_MODEL=
GROQ_MODEL=

# Text-to-Speech
GOOGLE_TTS_API_KEY=
SARVAM_API_KEY=
MURF_API_KEY=
OPENAI_API_KEY=

# HuggingFace
HUGGINGFACE_API_KEY=

# Email (Nodemailer) — used for emergency contact alerts
EMAIL_ENABLED=false
EMAIL_PROVIDER=
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# Server
PORT=8080
NODE_ENV=development
# Comma-separated browser origin allow-list. "*" is NOT honoured. In production
# an empty value blocks all cross-origin browser access. A "*" inside an entry
# matches a single DNS label, e.g. https://mantra-*-yourteam.vercel.app
CORS_ORIGIN=http://localhost:3000
# Render sits behind exactly one proxy hop (needed for correct client IPs).
TRUST_PROXY_HOPS=1
# Optional rate-limit overrides (defaults shown)
# RATE_LIMIT_GLOBAL_PER_15MIN=1000
# RATE_LIMIT_AUTH_FAILURES_PER_15MIN=60
# RATE_LIMIT_AI_PER_MIN=20
# RATE_LIMIT_AI_PER_DAY=500
# RATE_LIMIT_SENSITIVE_PER_HOUR=20
